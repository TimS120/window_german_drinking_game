{
  "seed": 42,
  "algorithm": {
    "name": "RecurrentMaskedPPO",
    "total_timesteps": 500000,
    "learning_rate": 0.0003,
    "learning_rate_schedule": [
      [0, 0.0003],
      [100000, 0.0003],
      [350000, 0.0001],
      [500000, 0.00003]
    ],
    "train_batch_size": 2048,
    "minibatch_size": 512,
    "rollout_fragment_length": 128,
    "num_epochs": 10,
    "gamma": 0.995,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coeff": 0.01,
    "entropy_coeff_schedule": [
      [0, 0.01],
      [100000, 0.01],
      [350000, 0.003],
      [500000, 0.001]
    ],
    "vf_coeff": 0.5,
    "vf_clip_range": 100.0,
    "max_grad_norm": 0.5,
    "kl_coeff": 0.0,
    "num_gpus": 0,
    "activation_fn": "ReLU",
    "encoder_hidden_layers": [128],
    "head_hidden_layers": [128],
    "lstm_cell_size": 256,
    "max_seq_len": 256
  },
  "reward": {
    "correct_guess": 1.0,
    "wrong_guess": -1.0,
    "invalid_action": -1.0,
    "win_bonus": 25.0
  },
  "evaluation": {
    "enabled": true,
    "eval_freq": 25000,
    "n_eval_episodes": 20,
    "deterministic": true,
    "num_env_runners": 0
  },
  "checkpoint": {
    "save_freq": 25000
  },
  "progress": {
    "enabled": true,
    "plot_every_iterations": 1,
    "smoothing_window": 10
  },
  "output": {
    "base_dir": "outputs"
  },
  "inference": {
    "deterministic": true
  }
}
